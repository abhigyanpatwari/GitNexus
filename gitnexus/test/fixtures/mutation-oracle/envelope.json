{
  "schemaVersion": 1,
  "description": "Gate 1 (U6): the vitest5 runner’s unmutated run matched a normal Vitest 5 run on the pure-JS category under these versions and settings. Results from other Vitest or Stryker versions are unvalidated until gates 2 and 3 pass again (KTD2). Regenerate with `npm run test:mutation:fidelity` (from gitnexus/).",
  "versions": {
    "vitest": "5.0.5",
    "stryker": "10.0.0",
    "node": "v22.23.3"
  },
  "platform": {
    "os": "linux",
    "release": "6.6.114.1-microsoft-standard-WSL2",
    "arch": "x64"
  },
  "stryker": {
    "concurrency": 2,
    "maxTestRunnerReuse": 0,
    "testRunner": "vitest5",
    "coverageAnalysis": "perTest",
    "disableTypeChecks": false,
    "timeoutMS": 10000
  },
  "config": {
    "base": {
      "file": "gitnexus/vitest.config.ts",
      "project": "default"
    },
    "run": {
      "file": "gitnexus/tools/mutation/vitest.mutation.config.ts",
      "project": "mutation"
    },
    "settings": {
      "pool": "forks",
      "isolate": true,
      "maxWorkers": 23,
      "globals": true,
      "environment": "node",
      "testTimeout": 30000,
      "hookTimeout": 120000,
      "teardownTimeout": 3000,
      "clearMocks": false,
      "mockReset": false,
      "restoreMocks": false,
      "unstubEnvs": false,
      "unstubGlobals": false,
      "includeTaskLocation": true,
      "env": {
        "GITNEXUS_ATOMIC_INCREMENTAL": "",
        "GITNEXUS_LANG": "en",
        "GITNEXUS_MEMORY": "off"
      },
      "sequence": {
        "groupOrder": 3,
        "hooks": "stack",
        "sequencer": "[function PerfSequencer]"
      }
    },
    "allowedDifferences": [
      {
        "name": "setupFiles",
        "paths": [
          "project.setupFiles"
        ],
        "reason": "The runner prepends its own setup file (tools/mutation/runner/setup.ts, loaded from the prepared copy next to the plugin) for coverage and mutant activation (KTD4). The gate 1 recorder is installed in both runs the same way."
      },
      {
        "name": "coverage",
        "paths": [
          "global.coverage.exclude",
          "project.coverage.exclude"
        ],
        "reason": "Vitest coverage is off in both runs; its resolved exclude list names the config file. Stryker records its own per-test coverage through the runner setup file."
      },
      {
        "name": "KTD8 aliases",
        "paths": [
          "vite.resolve.alias"
        ],
        "reason": "The mutation config resolves `gitnexus-shared` imports to the relocated sources inside the sandbox (KTD8); the base run resolves the package to its built `dist`. The module comparison checks both resolve to the same modules."
      },
      {
        "name": "dangerouslyIgnoreUnhandledErrors",
        "paths": [
          "global._rawTestConfig.dangerouslyIgnoreUnhandledErrors",
          "global.dangerouslyIgnoreUnhandledErrors",
          "project.dangerouslyIgnoreUnhandledErrors"
        ],
        "reason": "Off in the mutation config so an unhandled error fails the run (KTD9); gate 1 reports any unhandled error of the base run separately."
      },
      {
        "name": "cacheDir",
        "paths": [
          "global.cache",
          "global.cliOptions.cache",
          "global.cliOptions.fsModuleCache",
          "global.fsModuleCache",
          "global.providedOptions.fsModuleCache",
          "global.viteOverrides.cacheDir",
          "project.cache.dir",
          "project.fsModuleCache",
          "vite.cacheDir"
        ],
        "reason": "The runner uses a per-process Vite cache directory inside the sandbox and turns the results and fs module caches off (KTD5), so no run reuses another run’s transforms."
      },
      {
        "name": "project name",
        "paths": [
          "global.cliOptions.project",
          "global.project",
          "project.name"
        ],
        "reason": "The runner runs the single `mutation` project; Vitest task ids depend on the name, which is why tests are compared by file, titles and location instead."
      },
      {
        "name": "include and exclude lists",
        "paths": [
          "env.GITNEXUS_MUTATION_SCOPE",
          "project.exclude",
          "project.include"
        ],
        "reason": "The mutation project includes exactly the scope file’s test files (named by GITNEXUS_MUTATION_SCOPE); gate 1 runs the same file list on both sides."
      },
      {
        "name": "projects array",
        "paths": [
          "global.projects",
          "global.resolvedProjects"
        ],
        "reason": "The mutation config replaces the three repo projects with one (KTD9); the resolved project list follows it. The run project’s own config is compared key by key."
      },
      {
        "name": "sequence.groupOrder",
        "paths": [
          "project.sequence.groupOrder"
        ],
        "reason": "Orders projects against each other; a single-project run has nothing to order."
      },
      {
        "name": "config file (addition)",
        "paths": [
          "global.cliOptions.config",
          "global.config"
        ],
        "reason": "Addition to the plan’s list: the name of the config file. The Stryker run loads tools/mutation/vitest.mutation.config.ts (KTD9) through the gate 1 wrapper tools/mutation/fidelity/vitest.fidelity.config.ts; their settings are compared key by key."
      }
    ],
    "ignoredVolatileValues": [
      {
        "name": "sequence.seed",
        "paths": [
          "global.sequence.seed",
          "project.sequence.seed"
        ],
        "reason": "Defaults to the start time when unset and only drives shuffling; ignored only while shuffling is off in both runs."
      }
    ]
  },
