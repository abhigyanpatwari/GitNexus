    "sibling_parent_reads_function_scaling_ratio": 1.1,
    "sibling_child_reads_function_scaling_ratio": 1.1,
    "sibling_map_visits_function_scaling_ratio": 1.1,
    "sibling_capture_closure_scaling_ratio": 1.5,
    "sibling_resolve_closure_scaling_ratio": 1.5,
