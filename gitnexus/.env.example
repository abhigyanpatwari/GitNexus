# GitNexus Embedding API Configuration
# Copy this file to .env and fill in your values

# Set to 'true' to use API embeddings instead of local model
GITNEXUS_USE_API=true

# OpenAI-compatible API endpoint
GITNEXUS_EMBEDDING_API=https://api.openai.com/v1/embeddings

# Your API key
GITNEXUS_EMBEDDING_API_KEY=your-api-key-here

# Model name (depends on your API provider)
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# Azure: your-deployment-name
GITNEXUS_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (must match your model)
# text-embedding-3-small: 1536
# text-embedding-3-large: 3072
# text-embedding-ada-002: 1536
GITNEXUS_EMBEDDING_DIMENSIONS=1536

# Batch size for API requests
GITNEXUS_EMBEDDING_BATCH_SIZE=100
