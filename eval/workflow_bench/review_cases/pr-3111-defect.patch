+        repoPath,
+        cliOptions,
+        baselineEnvironment,
+        reportIgnoredConfig,
+      );
+    } catch (error) {
+      cliError(`  ${error instanceof Error ? error.message : String(error)}`);
+      process.exitCode = 1;
+      return;
+    }
