+    if (event !== 'add' && event !== 'change' && event !== 'unlink') return;
+    const relative = repoRelativeWatchPath(repoPath, changedPath);
+    if (relative && isRelevantWatchPath(relative) && !isAnalyzerOwnedWatchPath(relative)) {
